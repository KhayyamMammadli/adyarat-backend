NODE_ENV=development
PORT=3000

# Meta / WhatsApp Cloud API
META_GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=replace-with-temporary-or-permanent-token
META_PHONE_NUMBER_ID=replace-with-phone-number-id
META_APP_SECRET=replace-with-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-string

# Dəstək müraciətlərini qəbul edən şəxsi WhatsApp nömrəsi.
# Beynəlxalq formatda və + işarəsi olmadan yazılır.
SUPPORT_WA_ID=994509956663

# AI: normal text is answered by the first configured provider.
AI_DEFAULT_PROVIDER=auto
AI_PROVIDER_ORDER=gemini,openai,claude
AI_SYSTEM_PROMPT=Sən AdYarat WhatsApp AI köməkçisisən. İstifadəçinin dilində aydın, faydalı və yığcam cavab ver.
AI_REQUEST_TIMEOUT_MS=60000
AI_RETRY_ATTEMPTS=3
AI_MAX_REPLY_CHARS=3500

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Video generation: mock | runway
VIDEO_PROVIDER=mock
MOCK_VIDEO_PATH=assets/mock-video.mp4
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4.5
RUNWAY_DURATION=5
RUNWAY_RATIO=720:1280

# Optional Supabase persistence. Secret key is preferred for new projects.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Legacy fallback only; Supabase is deprecating service_role keys.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=adyarat-media

# Workers and limits
WEBHOOK_POLL_MS=1000
GENERATION_POLL_MS=3000

# Comma-separated WhatsApp sender IDs that can create unlimited videos during pilot testing.
PILOT_UNLIMITED_WA_IDS=

# Restart/crash sonrası processing vəziyyətində qalan videolar üçün 20 dəqiqə.
GENERATION_STALE_MS=1200000

MAX_IMAGE_BYTES=5242880
MAX_AUDIO_BYTES=26214400
MAX_DOCUMENT_BYTES=20971520
MAX_DOCUMENT_CHARS=500000
DOCUMENT_CHUNK_CHARS=8000
DOCUMENT_DEFAULT_TARGET_LANGUAGE=Azərbaycan dili
MAX_PROMPT_LENGTH=1000
